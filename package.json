{
  "name": "front-page-lab",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "description": "头版智造局 — BYOK 智能报纸/海报生成器 demo（零构建）",
  "author": "Front Page Lab",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "desktop": "electron desktop/main.mjs",
    "desktop:pack": "electron-builder --dir",
    "desktop:build": "electron-builder --win portable",
    "test": "node scripts/test-validate.mjs && node scripts/test-chat.mjs && node scripts/test-free.mjs && node scripts/test-icons.mjs && node scripts/test-image.mjs && node scripts/check-css.mjs",
    "check:css": "node scripts/check-css.mjs",
    "test:matrix": "node scripts/export-matrix.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "htm": "^3.1.1",
    "preact": "10.26.4"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.frontpagelab.desktop",
    "productName": "头版智造局",
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "server.mjs",
      "index.html",
      "src/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
